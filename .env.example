# ── Sécurité ──────────────────────────────────────────────────
SECRET_KEY=isi-dashboard-secret-CHANGE-IN-PRODUCTION

# ── Base de données ───────────────────────────────────────────
# SQLite (défaut) : laisser vide ou spécifier un chemin
DB_PATH=data/dashboard.db
# PostgreSQL (production) :
# DB_URL=postgresql://user:password@localhost:5432/isi_dashboard

# ── API ───────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8501

# ── OpenAI (optionnel — pour l'onglet IA) ────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Email SMTP (optionnel) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Application ───────────────────────────────────────────────
DEBUG=false
ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=7
